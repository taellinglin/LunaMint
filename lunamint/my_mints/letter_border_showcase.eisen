# Letter border + masked texture showcase (EisenScript)
front_banknote \
  seed_text="LunaMint" \
  denomination="100 卢纳币" \
  title="灵国国库" \
  subtitle="天圆地方" \
  specimen=true \
  width_mm=160 \
  height_mm=60 \
  enable_background=true \
  enable_qr_border=false \
  enable_microgrid=false \
  enable_decorative_border=false \
  enable_center_seal=false \
  enable_center_text=false \
  enable_corner_decorations=false \
  enable_corner_denoms=false \
  enable_microprint=false \
  bg_dir="./backgrounds" \
  background_prompt="ornate fabric weave, brocade, rich texture, high detail"

# Masked letter border overlay (top layer)
letter_border x_mm=2 y_mm=2 width_mm=156 height_mm=56 border_thickness_mm=4 text="linglin.art, llc" font="Daemon Full Working" font_size_mm=1.2 spacing_mm=0.2 case=lower base_fill="" pattern="stripes" pattern_color="#222222" pattern_opacity=0.45 opacity=1.0

# Center dial stamp
text_dial cx_mm=80 cy_mm=30 radius_mm=16 inner_radius_mm=0 text="linglin.art, llc" rings=8 font="Daemon Full Working" font_size_mm=1 spacing_mm=0.1 ring_gap_mm=0.3 rotation_seed="2026-01-26" snap_grid_px=0 clip_radius_mm=16 case=lower

# Optional grid cipher block
text_grid x_mm=6 y_mm=42 width_mm=40 height_mm=12 text="linglin.art, llc" font="Daemon Full Working" font_size_mm=0.9 spacing_mm=0.0 snap_grid_px=0
