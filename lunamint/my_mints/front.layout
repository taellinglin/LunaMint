# Front banknote mint script
use widgets.border_front
use filters.vectorize

enable widgets.gpu_ring
enable widgets.cpu_barcode
enable widgets.timecode
enable widgets.qr

set bill.side = "front"
set bill.title = "灵国国库"
set bill.subtitle = "天圆地方"
set bill.border.width = 6
set bill.font.size = 18
set bill.color.primary = "#1A1A1A"
set bill.color.accent = "#3A7AFE"
set bill.qr.mode = "sm2"
set bill.qr.verify_base_url = "https://bank.linglin.art/verify"
set bill.timecode.precision = "ms"
